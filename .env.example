# goodbooks settings. Copy to .env next to docker-compose.yml, fill it in (see README), and keep it private:
#   cp .env.example .env && chmod 600 .env
# .env holds your secrets: never commit it, and keep a copy offsite.

# Release to run: latest, a minor line (1.4), or an exact version (1.4.0).
GOODBOOKS_VERSION=latest
# The hostname people type, e.g. books.example.com. Use localhost for first-run setup.
APP_HOST=
# Rails zone name; "today" rolls over at local midnight.
TIME_ZONE=Central Time (US & Canada)

# Secrets: generate all four once (README, Install step 2) and never change them. Keep a copy offsite.
# Signs sign-in cookies. Changing it signs everyone out; nothing is lost.
SECRET_KEY_BASE=
# Encrypts 2FA secrets and bank tokens. Lost = locked out.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# Required by Rails' encryption; set it and keep it like the others.
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# Mixed into the primary key. Lost = same as losing that key.
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Optional Plaid bank feeds: set all three or none. See README.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox or production
PLAID_ENV=
