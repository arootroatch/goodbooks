<header class="page-header">
  <h1>Invoices</h1>
  <div class="page-actions">
    <%= secondary_action "Aging", business_invoice_aging_path(@business) %>
    <%= link_to "Download CSV", business_invoices_path(@business, @filter.params.merge(format: :csv)), class: "button no-print",
                data: { controller: "filter-link", filter_link_form_value: "invoice-filters" } %>
    <%= primary_action "New invoice", new_business_invoice_path(@business) if current_membership.can_edit? %>
  </div>
</header>
<%= render "invoices/open_cards", summary: @open, show_business: false, list_path: ->(status) { business_invoices_path(@business, status:) } %>
<%= form_with url: business_invoices_path(@business), method: :get, id: "invoice-filters", class: "filters no-print",
              data: { controller: "auto-submit", action: "change->auto-submit#submit", turbo_frame: "invoices" } do |f| %>
  <%= f.select :status, invoice_status_filter_options, selected: params[:status] %>
  <%= f.select :client_id, options_from_collection_for_select(@business.clients.order(:name), :id, :name, params[:client_id]), include_blank: "All clients" %>
  <%= f.date_field :from, value: params[:from] %>
  <%= f.date_field :to, value: params[:to] %>
  <noscript><%= f.submit "Filter" %></noscript>
<% end %>
<%= turbo_frame_tag "invoices", target: "_top", data: { turbo_action: "advance" } do %>
  <%= render "invoices/table", invoices: @invoices, show_business: false %>
  <p>
    <%= link_to "Previous", business_invoices_path(@business, @filter.params.merge(page: @filter.page - 1)) if @filter.page > 1 %>
    <%= link_to "Next", business_invoices_path(@business, @filter.params.merge(page: @filter.page + 1)) if @filter.next_page? %>
  </p>
<% end %>
