<%= form_with model: [@business, transaction] do |f| %>
  <%= render "shared/errors", record: transaction %>
  <% manual = transaction.new_record? || transaction.account.manual? %>
  <% if transaction.new_record? %>
    <p><%= f.label :account_id %> <%= f.collection_select :account_id, @business.accounts.manual.active.order(:name), :id, :name %></p>
  <% end %>
  <% if manual %>
    <p><%= f.label :posted_on, "Date" %> <%= f.date_field :posted_on, required: true %></p>
    <p><%= f.label :payee %> <%= f.text_field :payee, required: true %></p>
    <p>
      <%= f.label :amount %>
      <%= f.text_field :amount, value: transaction.amount_cents ? Money.new(transaction.amount_cents.abs).to_input : transaction.amount %>
      <% out = transaction.direction.present? ? transaction.direction == "out" : transaction.amount_cents.to_i <= 0 %>
      <label><%= f.radio_button :direction, "out", checked: out %> Money out</label>
      <label><%= f.radio_button :direction, "in", checked: !out %> Money in</label>
    </p>
  <% else %>
    <p><%= transaction.posted_on %> · <%= transaction.payee %> · <%= money(transaction.amount_cents) %> (imported, read-only)</p>
  <% end %>
  <p><%= f.label :memo %> <%= f.text_field :memo %></p>
  <% categories = @business.categories.active.or(@business.categories.where(id: transaction.category_id)).order(:name) %>
  <p>
    <%= f.label :category_id %>
    <%= f.grouped_collection_select :category_id, category_groups(categories), :last, :first, :id, :name, include_blank: "Uncategorized" %>
  </p>
  <% money_in = transaction.new_record? || transaction.amount_cents.to_i.positive? %>
  <% if @business.business? && (transaction.processor_fee_cents.to_i.positive? || money_in) %>
    <p><%= f.label :processor_fee, "Processor fee" %> <%= f.text_field :processor_fee, size: 10, inputmode: "decimal" %> <small>card processor's fee on a deposit</small></p>
  <% end %>
  <% taxable_category = transaction.category.nil? || transaction.category.taxable? %>
  <% if transaction.sales_tax_cents.to_i.positive? || (@business.collects_sales_tax? && money_in && taxable_category) %>
    <p>
      <%= f.label :sales_tax, "Sales tax" %> <%= f.text_field :sales_tax, size: 10, inputmode: "decimal" %>
      <% if @business.collects_sales_tax? %>
        <%= button_tag "Tax-inclusive at default rate (#{@business.sales_tax_profile.default_rate_percent}%)",
              type: "submit", name: "apply_inclusive_tax", value: "1" %>
      <% end %>
      <% if transaction.persisted? && transaction.invoice_tax_cents.positive? %>
        <small>plus <%= money(transaction.invoice_tax_cents) %> from linked invoices</small>
      <% end %>
    </p>
  <% end %>
  <% if @business.collects_sales_tax? && transaction.category&.sales_tax_remittance? %>
    <p>
      <%= f.label :sales_tax_period_starts_on, "Sales tax period (remittances)" %>
      <%= f.select :sales_tax_period_starts_on, sales_tax_period_options(@business),
            { include_blank: "Default", selected: transaction.sales_tax_period_starts_on&.iso8601 } %>
    </p>
  <% end %>
  <p><%= f.label :transfer %> <%= f.check_box :transfer %></p>
  <p><%= f.label :excluded %> <%= f.check_box :excluded %></p>
  <%= f.submit %>
<% end %>
<% if transaction.persisted? && transaction.account.manual? %>
  <%= button_to "Delete", business_transaction_path(@business, transaction), method: :delete %>
<% end %>
