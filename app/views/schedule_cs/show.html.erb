<header class="page-header">
  <h1>Schedule C summary <%= @year %></h1>
  <%= secondary_action "Mileage log (CSV)", business_mileage_log_path(@business, year: @year, format: :csv) %>
</header>
<p class="no-print">
  <%= link_to "← #{@year - 1}", business_schedule_c_path(@business, year: @year - 1) %>
  <%= link_to "#{@year + 1} →", business_schedule_c_path(@business, year: @year + 1) %>
</p>
<% if @mileage.missing_rate_years.any? %>
  <p class="flash-alert">Mileage is excluded: no IRS rate set for <%= @year %>.</p>
<% end %>
<%= render "shared/uncategorized_notice", count: @uncategorized_count, inbox_path: business_inbox_path(@business) %>
<table>
  <tbody>
    <% @summary.lines.each do |code, cents| %>
      <tr>
        <td><%= ScheduleC.label(code) %></td>
        <td class="num"><%= money(cents) %></td>
        <% if cents.negative? && ScheduleC::INCOME_LINES.exclude?(code) %>
          <td class="flash-alert">Negative — refunds exceed expenses on this line; check categorization.</td>
        <% end %>
      </tr>
    <% end %>
    <tr><th>Gross income</th><th class="num"><%= money(@summary.gross_income_cents) %></th></tr>
    <tr><th>Total expenses</th><th class="num"><%= money(@summary.total_expenses_cents) %></th></tr>
    <tr><th>Tentative profit (line 29)</th><th class="num"><%= money(@summary.tentative_profit_cents) %></th></tr>
    <tr>
      <td><%= ScheduleC.label("30") %></td>
      <td class="num"><%= @summary.home_office_used_cents ? money(@summary.home_office_used_cents) : "—" %></td>
      <% if @can_edit_home_office %>
        <td class="no-print"><%= link_to @home_office ? "Edit home office" : "Add home office", edit_business_home_office_path(@business, @year) %></td>
      <% end %>
    </tr>
    <tr><th>Net profit</th><th class="num"><%= money(@summary.net_profit_cents) %></th></tr>
  </tbody>
</table>
