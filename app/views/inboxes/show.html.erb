<header class="page-header">
  <h1>Inbox (<%= @total %>)</h1>
  <% if current_membership.can_edit? %>
    <%= button_to "Apply rules to inbox", apply_business_rules_path(@business) %>
  <% end %>
</header>
<%= render "shared/inbox_truncation", shown: @transactions.size, total: @total %>
<%= render "inboxes/review_rows", business: @business, rows: @review, editable: current_membership.can_edit? %>
<%= render "inboxes/table", business: @business, transactions: @transactions, categories: @categories,
                            editable: current_membership.can_edit?, matcher: @matcher %>
