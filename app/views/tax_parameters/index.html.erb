<header class="page-header">
  <h1>Tax parameters</h1>
  <%= primary_action "Add a year", new_tax_parameter_path %>
</header>
<table>
  <thead><tr><th>Year</th><th class="num">Mileage rate</th><th>Federal figures</th><th></th></tr></thead>
  <tbody>
    <% @all.each do |tp| %>
      <tr><td><%= tp.year %></td><td class="num"><%= tp.mileage_rate_cents %>¢</td><td><%= tp.estimate_ready? ? "Complete" : "Mileage only" %></td><td><div class="button-group"><%= link_to "Edit", edit_tax_parameter_path(tp) %></div></td></tr>
    <% end %>
  </tbody>
</table>
