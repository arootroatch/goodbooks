<div class="segmented theme-toggle" role="group" aria-label="Theme" data-controller="theme">
  <% glyphs = { "system" => "◐", "light" => "☀", "dark" => "☾" } %>
  <% Theme::CHOICES.each do |choice| %>
    <%= button_to theme_path, method: :patch, params: { theme: choice },
          form: { data: { action: "submit->theme#choose" } },
          aria: { pressed: current_theme == choice },
          data: { theme_target: "option", theme_choice: choice } do %>
      <span aria-hidden="true"><%= glyphs.fetch(choice) %></span> <%= choice.capitalize %>
    <% end %>
  <% end %>
</div>
