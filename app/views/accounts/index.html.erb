<header class="page-header">
  <h1>Accounts</h1>
  <%= primary_action "New account", new_business_account_path(@business) if current_membership.owner? %>
</header>
<% if @show_archived %>
  <%= link_to "Hide archived", business_accounts_path(@business) %>
<% else %>
  <%= link_to "Show archived", business_accounts_path(@business, archived: "1") %>
<% end %>
<table>
  <thead><tr><th>Name</th><th>Source</th><th>Kind</th><% if @business.personal? %><th>Tithe</th><% end %><th class="num">Balance</th><th></th></tr></thead>
  <tbody>
    <% @accounts.each do |account| %>
      <tr id="<%= dom_id(account) %>">
        <td><%= link_to account.name, business_transactions_path(@business, account_id: account.id) %><%= " (archived)" if account.archived? %></td>
        <td><%= account.plaid_item ? render("accounts/plaid_status", account: account) : account.source %></td>
        <td><%= account.kind %></td>
        <% if @business.personal? %><td class="tithe"><%= account.tithable? ? "Counted" : tag.span("Not counted", class: "muted") %></td><% end %>
        <td class="num balance"><%= money(account.balance_cents) %></td>
        <td>
          <div class="button-group">
            <%= link_to "Import CSV", new_business_account_csv_import_path(@business, account) if account.csv_importable? && !account.archived? && current_membership.can_edit? %>
            <% if current_membership.owner? %>
              <%= link_to "Edit", edit_business_account_path(@business, account) %>
              <%= archive_button [@business, account] %>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
