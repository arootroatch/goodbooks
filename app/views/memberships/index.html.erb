<header class="page-header">
  <h1>Members</h1>
  <%= primary_action "Invite someone", new_invite_path %>
</header>
<table>
  <thead><tr><th>Name</th><th>Email</th><th>Role</th><th></th></tr></thead>
  <tbody>
    <% @memberships.each do |membership| %>
      <tr>
        <td><%= membership.user.name %></td>
        <td><%= membership.user.email_address %></td>
        <td>
          <%= form_with model: [@business, membership], class: "inline-form" do |f| %>
            <%= f.select :role, Membership::RANK.keys.map { [_1.humanize, _1] } %>
            <%= f.submit "Save" %>
          <% end %>
        </td>
        <td><div class="button-group"><%= confirm_button "Remove", business_membership_path(@business, membership), method: :delete, confirm: "Remove #{membership.user.name} from #{@business.name}?" %></div></td>
      </tr>
    <% end %>
  </tbody>
</table>
