<%# Tithe at a glance: last week, this week, and the running balance. %>
<% this_week = ledger.weeks.last %>
<% last_week = ledger.weeks[-2] %>
<section class="card tithe-summary">
  <header class="tithe-summary-header">
    <h2>Tithe</h2>
    <% if local_assigns[:details_path] %><span><%= link_to "Tithe details", details_path %> →</span><% end %>
  </header>
  <% if last_week %>
    <div class="tithe-last-week">
      <h3 class="card-title">Last week <small><%= tithe_week_label(last_week) %></small></h3>
      <dl>
        <div><dt>Tithe owed</dt><dd><%= money(last_week.owed_cents) %></dd></div>
        <div><dt>Given</dt><dd><%= money(last_week.paid_cents) %></dd></div>
      </dl>
      <%= tithe_status_badge(last_week.status) %>
    </div>
  <% end %>
  <div class="tithe-this-week">
    <h3 class="card-title">This week <small><%= tithe_week_label(this_week) %></small></h3>
    <dl>
      <div><dt>Income</dt><dd><%= money(this_week.income_cents) %></dd></div>
      <div><dt>Tithe owed</dt><dd><%= money(this_week.owed_cents) %></dd></div>
      <div><dt>Given</dt><dd><%= money(this_week.paid_cents) %></dd></div>
    </dl>
  </div>
  <div class="tithe-balance">
    <h3 class="card-title">Overall</h3>
    <b class="<%= "neg" if ledger.balance_cents.positive? %>"><%= tithe_balance_label(ledger.balance_cents) %></b>
    <p><%= tithe_balance_advice(ledger.balance_cents) %></p>
    <small>This year: owed <%= money(ledger.ytd_owed_cents) %> · given <%= money(ledger.ytd_paid_cents) %></small>
  </div>
</section>
