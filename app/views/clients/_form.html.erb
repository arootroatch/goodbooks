<%= form_with model: [@business, client] do |f| %>
  <%= render "shared/errors", record: client %>
  <p><%= f.label :name %> <%= f.text_field :name, required: true %></p>
  <p><%= f.label :email %> <%= f.email_field :email %></p>
  <p><%= f.label :notes %> <%= f.text_area :notes, rows: 3 %></p>
  <%= f.submit %>
<% end %>
