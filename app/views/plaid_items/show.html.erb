<header class="page-header">
  <div>
    <h1><%= @item.institution_name %> <%= plaid_status_badge(@item) %></h1>
    <p class="subtitle"><%= @item.last_synced_at ? "Last synced #{time_ago_in_words(@item.last_synced_at)} ago" : "Not synced yet" %></p>
  </div>
  <div class="page-actions">
    <%= secondary_action "All bank connections", plaid_items_path %>
    <%= secondary_action "Assign accounts", plaid_item_assignment_path(@item) %>
    <%= button_to "Sync now", sync_plaid_item_path(@item) %>
    <%= confirm_button "Remove connection", plaid_item_path(@item), method: :delete,
                       confirm: "Stop syncing #{@item.institution_name}? Transactions already imported stay." %>
    <%= primary_action "Reconnect", new_plaid_item_reconnection_path(@item) if @item.reconnectable? %>
  </div>
</header>
<% if @item.last_error.present? %>
  <p class="errors"><%= @item.last_error %></p>
<% end %>
<% if @gateway_error %>
  <p class="errors">Couldn't reach Plaid: <%= @gateway_error %></p>
<% end %>
<h2 class="section-title">Accounts</h2>
<% reported = @plaid_accounts&.map { _1[:account_id] } %>
<table>
  <thead><tr><th>Bank account</th><th>Feeds</th><th></th></tr></thead>
  <tbody>
    <% @item.accounts.includes(:business).order(:name).each do |account| %>
      <tr id="<%= dom_id(account) %>">
        <td><%= account.plaid_name %> ····<%= account.plaid_mask %></td>
        <td>
          <%= link_to "#{book_label(account.business)} › #{account.name}", business_transactions_path(account.business, account_id: account.id) %>
          <%= " · No longer reported by the bank" if reported && !reported.include?(account.plaid_account_id) %>
        </td>
        <td>
          <div class="button-group">
            <%= confirm_button "Unlink", plaid_item_account_link_path(@item, account), method: :delete,
                               confirm: "Stop feeding #{account.name} from #{@item.institution_name}? Its transactions stay, and you can assign the bank account to another book." %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<% unassigned = @plaid_accounts.to_a.count { !@item.accounts.map(&:plaid_account_id).include?(_1[:account_id]) } %>
<% if unassigned.positive? %>
  <p class="muted"><%= pluralize(unassigned, "bank account") %> not assigned yet. <%= link_to "Assign accounts", plaid_item_assignment_path(@item) %></p>
<% end %>
