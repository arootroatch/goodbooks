<%= business_nav @business %>
<h1>Categories</h1>
<table>
  <thead>
    <tr>
      <th>Name</th><th>Kind</th>
      <% if @business.personal? %><th>Tithe</th><% else %><th>Schedule C</th><th class="num">Deductible</th><% if @business.collects_sales_tax? %><th>Sales tax</th><% end %><% end %>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= category.name %><%= " (archived)" if category.archived? %></td>
        <td><%= category.kind %></td>
        <% if @business.personal? %>
          <td><%= category_tithe_label(category) %></td>
        <% else %>
          <td><%= category.schedule_c_line ? ScheduleC.label(category.schedule_c_line) : "—" %></td>
          <td class="num"><%= category.deductible_percent %>%</td>
          <% if @business.collects_sales_tax? %>
            <td><%= Category::SALES_TAX_TREATMENT_LABELS[category.sales_tax_treatment] %></td>
          <% end %>
        <% end %>
        <td><%= link_to "Edit", edit_business_category_path(@business, category) if current_membership.can_edit? %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= link_to "New category", new_business_category_path(@business) if current_membership.can_edit? %>
