<header class="page-header">
  <h1>Categories</h1>
  <%= primary_action "New category", new_business_category_path(@business) if current_membership.can_edit? %>
</header>
<table>
  <thead>
    <tr>
      <th>Name</th><th>Kind</th>
      <% if @business.personal? %><th>Tithe</th><% else %><th>Schedule C</th><th class="num">Deductible</th><% end %>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= category.name %><%= " (archived)" if category.archived? %></td>
        <td><%= category.kind %></td>
        <% if @business.personal? %>
          <td><%= category_tithe_label(category) %></td>
        <% else %>
          <td><%= ScheduleC.label(category.schedule_c_line) %></td>
          <td class="num"><%= category.deductible_percent %>%</td>
        <% end %>
        <td><%= link_to "Edit", edit_business_category_path(@business, category) if current_membership.can_edit? %></td>
      </tr>
    <% end %>
  </tbody>
</table>
